---
const navLinks = [
  { href: "#apropos", label: "À propos" },
  { href: "#veille", label: "Veille technologique" },
  { href: "#projets", label: "Projets" },
  { href: "#stack", label: "Environnement" },
  { href: "#interets", label: "Sources" },
  { href: "#films", label: "Films & séries" },
  { href: "#jeux", label: "Jeux vidéos" },
];
---

<header class="hero">
  <nav class="nav">
    <span class="nav-brand">&lt;/&gt;</span>
    <div class="nav-links">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </nav>

  <div class="hero-content">
    <p class="eyebrow">Conception et orchestration de systèmes</p>
    <h1>Matglitch<span class="cursor">_</span></h1>
    <p class="tagline">
      Je conçois et pilote des projets logiciels assistés par agents IA, d'un
      système d'exploitation Linux universel aux interfaces Liquid Glass.
      Organisation fondée sur la méthode PRAXIS (<a href="https://arscripta.fr" target="_blank" rel="noopener noreferrer">ARSCRIPTA</a>).
    </p>
    <div class="hero-tags">
      <span>Systèmes &amp; OS</span>
      <span>Automatisation</span>
      <span>Développement assisté par IA</span>
      <span>Méthode PRAXIS</span>
    </div>
  </div>
</header>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .nav-brand {
    font-family: var(--mono);
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .nav-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .nav-links a {
    color: var(--fg-dim);
    font-size: 0.85rem;
    font-family: var(--mono);
  }
  .nav-links a:hover { color: var(--accent); text-decoration: none; }

  .hero {
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 15% 20%, var(--accent-dim), transparent 45%),
      var(--bg);
  }

  .hero-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
  }

  .eyebrow {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .tagline {
    color: var(--fg-dim);
    max-width: 640px;
    font-size: 1.1rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .hero-tags span {
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
  }
</style>
