---
import { entryCount, type Tile } from "../data/tiles";

interface Props {
  items: Tile[];
  /** Sous-dossier de public/img contenant les images. */
  folder: string;
  /** Préfixe des identifiants, unique par grille. */
  id: string;
}

const { items, folder, id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const img = (file: string) => `${base}/img/${folder}/${file}`;
---

<ul class="tiles">
  {items.map((t, i) => (
    <li class="tile">
      {t.groups ? (
        <>
          <button
            class="head toggle"
            type="button"
            aria-expanded="false"
            aria-controls={`${id}-${i}`}
          >
            <img class="bg" src={img(t.image)} alt="" loading="lazy" decoding="async" />
            <span class="text">
              <span class="title">{t.title}</span>
              <span class="desc">{t.description}</span>
              <span class="meta">
                {entryCount(t)} titres
                <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </button>
          <div class="panel" id={`${id}-${i}`} inert>
            <div class="panel-inner">
              {t.groups.map((g) => (
                <div class="group">
                  {g.title && <p class="group-title">{g.title}</p>}
                  <ul class="entries">
                    {g.entries.map((e) => (
                      <li>
                        <a href={e.url} target="_blank" rel="noopener noreferrer">
                          {e.image ? (
                            <img class="thumb" src={img(e.image)} alt="" loading="lazy" decoding="async" />
                          ) : (
                            <span class="thumb glyph" aria-hidden="true">{e.glyph ?? e.title.charAt(0)}</span>
                          )}
                          <span class="entry-text">
                            <span class="entry-title">{e.title}</span>
                            {e.note && <span class="entry-note">{e.note}</span>}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </>
      ) : (
        <a class="head" href={t.url} target="_blank" rel="noopener noreferrer">
          <img class="bg" src={img(t.image)} alt="" loading="lazy" decoding="async" />
          <span class="text">
            <span class="title">{t.title}</span>
            <span class="desc">{t.description}</span>
          </span>
          <span class="external" aria-hidden="true">↗</span>
        </a>
      )}
    </li>
  ))}
</ul>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".tiles .toggle")) {
    button.addEventListener("click", () => {
      const tile = button.closest(".tile")!;
      const panel = document.getElementById(button.getAttribute("aria-controls")!)!;
      const open = !tile.classList.contains("open");
      tile.classList.toggle("open", open);
      button.setAttribute("aria-expanded", String(open));
      panel.inert = !open;
    });
  }
</script>

<style>
  .tiles {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    /* Une tuile dépliée s'allonge sans étirer ses voisines */
    align-items: start;
  }

  .tile {
    position: relative;
    overflow: hidden;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }
  .tile:hover,
  .tile.open { border-color: var(--accent); }

  .head {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 170px;
    padding: 1.1rem 1.2rem;
    margin: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
    isolation: isolate;
  }
  .head:hover { text-decoration: none; }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    transition: opacity 0.3s ease, transform 0.5s ease;
  }
  .head:hover .bg,
  .tile.open .bg { opacity: 0.7; transform: scale(1.04); }

  /* Voile assurant la lisibilité du texte par-dessus l'image */
  .head::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(11, 13, 16, 0.96) 15%, rgba(11, 13, 16, 0.35));
  }

  .text { display: flex; flex-direction: column; gap: 0.25rem; }

  .title { font-size: 1.02rem; font-weight: 700; line-height: 1.3; }
  .head:hover .title { color: var(--accent); }

  .desc { font-size: 0.82rem; color: var(--fg-dim); line-height: 1.4; }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent);
  }

  .chevron {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tile.open .chevron { transform: rotate(180deg); }

  .external {
    position: absolute;
    top: 0.8rem;
    right: 1rem;
    color: var(--accent);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .head:hover .external,
  .head:focus-visible .external { opacity: 1; transform: none; }

  /* Dépliage : hauteur animée de 0 à son contenu via grid-template-rows */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tile.open .panel { grid-template-rows: 1fr; }

  .panel-inner {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tile.open .panel-inner { opacity: 1; transition-delay: 0.1s; }

  .group { padding: 0 0.6rem 0.6rem; }
  .group:first-child { padding-top: 0.6rem; }

  .group-title {
    margin: 0.5rem 0.6rem 0.4rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .entries { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }

  .entries a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    color: var(--fg);
    transition: background 0.15s ease;
  }
  .entries a:hover { background: rgba(255, 255, 255, 0.04); text-decoration: none; }
  .entries a:hover .entry-title { color: var(--accent); }

  .thumb {
    flex-shrink: 0;
    width: 64px;
    height: 36px;
    border-radius: 5px;
    object-fit: cover;
    background: var(--accent-dim);
  }

  .glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent);
  }

  .entry-text { display: flex; flex-direction: column; min-width: 0; }
  .entry-title { font-size: 0.88rem; font-weight: 600; transition: color 0.15s ease; }
  .entry-note { font-size: 0.75rem; color: var(--fg-dim); line-height: 1.35; }

  @media (prefers-reduced-motion: reduce) {
    .bg, .chevron, .panel, .panel-inner, .external { transition: none; }
  }
</style>
