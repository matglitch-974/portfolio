---
import { channels } from "../data/youtube";
---

<section id="interets" class="section">
  <h2><span class="idx">05</span> Veille tech</h2>
  <div class="prose">
    <p>
      Une veille YouTube tech dense et variée : hardware, développement et
      carrière, cybersécurité, actualité et culture tech, IA, économie et
      investissement. Suivie aussi sur <a href="https://x.com/matglitch974" target="_blank" rel="noopener noreferrer">X (@matglitch974)</a>.
    </p>
  </div>
  <ul class="chips">
    {channels.map((c) => (
      <li>
        <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .chips {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips a {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
  }
  .chips a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>
