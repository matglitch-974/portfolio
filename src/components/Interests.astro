---
import { channels, channelUrl } from "../data/youtube";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="interets" class="section">
  <h2><span class="idx">05</span> Veille tech</h2>
  <div class="prose">
    <p>
      Une veille YouTube tech dense et variée : hardware, développement et
      carrière, cybersécurité, actualité et culture tech, IA, économie et
      investissement.
    </p>
  </div>

  <ul class="chips">
    <li>
      <a class="chip chip-x" href="https://x.com/matglitch974" target="_blank" rel="noopener noreferrer">
        <img
          class="pic"
          src={`${base}/img/avatars/x-matglitch974.jpg`}
          alt="Photo de profil de matglitch974 sur X"
          loading="lazy"
          width="30"
          height="30"
        />
        <span>@matglitch974</span>
      </a>
    </li>
    {channels.map((c) => (
      <li>
        <a class="chip" href={channelUrl(c)} target="_blank" rel="noopener noreferrer">
          {c.pic ? (
            <img
              class="pic"
              src={`${base}/img/avatars/${c.pic}`}
              alt={`Photo de profil de la chaîne ${c.name}`}
              loading="lazy"
              width="30"
              height="30"
            />
          ) : (
            <span class="pic initial">{c.name.charAt(0)}</span>
          )}
          <span>{c.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .chips {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.28rem 0.9rem 0.28rem 0.28rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .chip-x {
    color: var(--fg);
    border-color: var(--accent-dim);
    background: var(--bg-alt);
  }

  .pic {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--accent-dim);
    flex-shrink: 0;
  }

  .initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
