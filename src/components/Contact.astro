---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="coordonnees" class="section">
  <h2><span class="idx">08</span> Coordonnées</h2>
  <div class="contacts">
  <a class="contact" href="mailto:matglitch974@gmail.com">
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M3 6.5h18v11H3z M3 7l9 6.5L21 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
    </span>
    <span class="text">
      <span class="label">E-mail</span>
      <span class="handle">matglitch974@gmail.com</span>
    </span>
  </a>
  <a class="contact" href="https://x.com/matglitch974" target="_blank" rel="noopener noreferrer">
    <img
      src={`${base}/img/avatars/x-matglitch974.jpg`}
      alt="Photo de profil de matglitch974 sur X"
      loading="lazy"
      width="48"
      height="48"
    />
    <span class="text">
      <span class="label">X (Twitter)</span>
      <span class="handle">@matglitch974</span>
    </span>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
  </div>
</section>

<style>
  .contacts { display: flex; flex-wrap: wrap; gap: 1rem; }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent-dim);
    color: var(--accent);
  }
  .icon svg { width: 22px; height: 22px; }

  .contact {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem 0.9rem 0.9rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--fg);
    transition: border-color 0.2s ease;
  }
  .contact:hover { border-color: var(--accent); text-decoration: none; }

  img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .text { display: flex; flex-direction: column; }

  .label {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }

  .handle { font-family: var(--mono); font-size: 1rem; overflow-wrap: anywhere; }

  .arrow {
    margin-left: 0.75rem;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .contact:hover .arrow { transform: translate(2px, -2px); }
</style>
