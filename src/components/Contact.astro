---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="coordonnees" class="section">
  <h2><span class="idx">08</span> Coordonnées</h2>
  <a class="contact" href="https://x.com/matglitch974" target="_blank" rel="noopener noreferrer">
    <img
      src={`${base}/img/avatars/x-matglitch974.jpg`}
      alt="Photo de profil de matglitch974 sur X"
      loading="lazy"
      width="48"
      height="48"
    />
    <span class="text">
      <span class="label">X (Twitter)</span>
      <span class="handle">@matglitch974</span>
    </span>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
</section>

<style>
  .contact {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem 0.9rem 0.9rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--fg);
    transition: border-color 0.2s ease;
  }
  .contact:hover { border-color: var(--accent); text-decoration: none; }

  img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .text { display: flex; flex-direction: column; }

  .label {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }

  .handle { font-family: var(--mono); font-size: 1rem; }

  .arrow {
    margin-left: 0.75rem;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .contact:hover .arrow { transform: translate(2px, -2px); }
</style>
