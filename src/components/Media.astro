---
import TileGrid from "./TileGrid.astro";
import { movies } from "../data/media";
---

<section id="films" class="section">
  <h2><span class="idx">06</span> Films & séries</h2>
  <div class="prose">
    <p>
      Une sélection marquée par la science-fiction et par les récits portant
      un regard critique sur la technologie, sans oublier les classiques de la
      comédie française.
    </p>
  </div>
  <TileGrid items={movies} folder="films" id="film" />
</section>
