---
import { movies, mediaGroups } from "../data/media";
---

<section id="films" class="section">
  <h2><span class="idx">06</span> Films & séries</h2>
  <div class="prose">
    <p>
      Une sélection marquée par la science-fiction et par les récits portant
      un regard critique sur la technologie.
    </p>
  </div>
  <ul class="chips">
    {movies.map((m) => (
      <li>
        <a href={m.url} target="_blank" rel="noopener noreferrer">{m.title}</a>
      </li>
    ))}
  </ul>

  {mediaGroups.map((g) => (
    <div class="group">
      <h3>{g.title}</h3>
      <ul class="chips">
        {g.items.map((m) => (
          <li>
            <a href={m.url} target="_blank" rel="noopener noreferrer">{m.title}</a>
          </li>
        ))}
      </ul>
      {g.subgroups?.map((s) => (
        <div class="subgroup">
          <h4>{s.title}</h4>
          <ul class="chips">
            {s.items.map((m) => (
              <li>
                <a href={m.url} target="_blank" rel="noopener noreferrer">{m.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ))}
</section>

<style>
  .chips {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips a {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .chips a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .group {
    margin-top: 2.5rem;
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .group h3,
  .group h4 {
    margin: 0;
    font-family: var(--mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .group h3 { font-size: 0.8rem; color: var(--accent); }
  .group h4 { font-size: 0.72rem; color: var(--fg-dim); }

  .group .chips { margin-top: 1rem; }

  .subgroup {
    margin-top: 1.4rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent-dim);
  }
  .subgroup .chips { margin-top: 0.75rem; }
</style>
