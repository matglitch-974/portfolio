---
import { movies } from "../data/media";
---

<section id="films" class="section">
  <h2><span class="idx">06</span> Films & séries</h2>
  <div class="prose">
    <p>
      Une sélection marquée par la science-fiction et par les récits portant
      un regard critique sur la technologie.
    </p>
  </div>
  <ul class="chips">
    {movies.map((m) => (
      <li>
        <a href={m.url} target="_blank" rel="noopener noreferrer">{m.title}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .chips {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips a {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
  }
  .chips a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>
