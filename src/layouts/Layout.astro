---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Matglitch — Portfolio",
  description = "Conception et orchestration de projets logiciels assistés par agents IA : systèmes, interfaces et automatisation, selon la méthode PRAXIS (ARSCRIPTA).",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
